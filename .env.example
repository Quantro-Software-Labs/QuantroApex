# ==============================================================================
# QuantroApex Environment Variables Template
# Copy this file to .env and fill in your custom credentials.
#
# SECURITY NOTICE:
#   - Never commit your actual .env file to version control.
#   - Generate strong secrets with: openssl rand -hex 32
#   - In production, all REPLACE_WITH_* values MUST be changed before deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL 16 via Prisma)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://quantroapex:quantroapex_dev@localhost:5433/quantroapex?schema=public"

# ------------------------------------------------------------------------------
# 2. API GATEWAY SERVER
# ------------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# CORS origin — set to your production domain(s) in production.
# Multiple origins: CORS_ORIGIN=https://app.example.com,https://www.example.com
# Development only: CORS_ORIGIN=*
CORS_ORIGIN=*

# Global rate limit (requests per minute). Default: 120
RATE_LIMIT_MAX=120

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & JWT SECURITY
#
# CRITICAL: Generate strong secrets before production deployment.
#   Run: openssl rand -hex 32
#
# The server will refuse to start if these are missing.
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=REPLACE_WITH_STRONG_32_CHAR_SECRET_run_openssl_rand_hex_32
JWT_REFRESH_SECRET=REPLACE_WITH_STRONG_32_CHAR_SECRET_run_openssl_rand_hex_32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. ALPACA TRADING BROKER INTEGRATION (Paper / Sandbox API)
# Get credentials at: https://alpaca.markets/ (Paper Trading Dashboard)
# Note: If left blank, QuantroApex automatically uses a high-fidelity Paper Simulation Broker.
# ------------------------------------------------------------------------------
ALPACA_API_KEY=your_alpaca_paper_api_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2

# ------------------------------------------------------------------------------
# 5. FIREBASE / PUSH NOTIFICATION SERVICES (FCM Alerts)
# Obtain from Firebase Console > Project Settings > Service Accounts
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=REPLACE_WITH_YOUR_FIREBASE_PROJECT_ID
FIREBASE_CLIENT_EMAIL=REPLACE_WITH_YOUR_FIREBASE_CLIENT_EMAIL
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_YOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 6. MOBILE CLIENT API CONFIGURATION
# Used as --dart-define=API_BASE_URL=<value> in Flutter build commands.
#
# Android Emulator → host machine:  http://10.0.2.2:3000
# iOS Simulator → host machine:     http://127.0.0.1:3000
# Physical device → your LAN IP:    http://192.168.x.x:3000
# Production:                        https://api.yourdomain.com
# ------------------------------------------------------------------------------
API_BASE_URL=http://10.0.2.2:3000
