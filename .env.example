# QuantroApex Environment Variables
# Copy to .env — never commit real secrets.

# Firebase (Auth + FCM — same project)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=

# Supabase Postgres
# - Transaction pooler (:6543) — good for the API app; IPv4-friendly
# - Session pooler (same host :5432) — better for data-pipeline bulk ingest
# - Direct db.<ref>.supabase.co:5432 — often IPv6-only; fails with
#   "Network is unreachable" on many home/ISP networks
#
# For data-pipeline, prefer Session mode from the dashboard:
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Local fallback (docker compose --profile local-db)
# DATABASE_URL=postgresql://quantroapex:quantroapex_dev@localhost:5433/quantroapex?schema=public
# DIRECT_URL=postgresql://quantroapex:quantroapex_dev@localhost:5433/quantroapex?schema=public
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Alpaca (trading + market data — used by api-gateway and data-pipeline)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2
ALPACA_DATA_URL=https://data.alpaca.markets/v2

# Crypto / Forex brokers (execution — optional for data-pipeline ingest)
CRYPTO_EXCHANGE=binance
CRYPTO_API_KEY=
CRYPTO_API_SECRET=
# OANDA — US-restricted; data-pipeline forex uses Twelve Data instead
OANDA_API_KEY=
OANDA_ACCESS_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_BASE_URL=https://api-fxpractice.oanda.com
OANDA_ENVIRONMENT=practice
POLYGON_API_KEY=

# Twelve Data — forex OHLCV (works from Nigeria; free tier at twelvedata.com)
TWELVEDATA_API_KEY=

# Data Pipeline (services/data-pipeline — V2 AI foundation)
CHECKPOINT_DIR=./checkpoints
DATA_SERVICE_URL=http://localhost:8002
DATA_SERVICE_HOST=0.0.0.0
DATA_SERVICE_PORT=8002

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_PLAN_CORE=
PAYSTACK_PLAN_PRO=
PAYSTACK_PLAN_ELITE=
PAYSTACK_WEBHOOK_SECRET=

# Sumsub KYC
SUMSUB_APP_TOKEN=sbx:...
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=
SUMSUB_LEVEL_NAME=basic-kyc-level
KYC_BYPASS=false

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@quantrolabs.app

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=

# PostHog / Sentry — set production values before beta; leave empty in local dev
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=
# Uptime: monitor GET $API_BASE_URL/health every 60s; alert if down > 2 minutes

# App
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=*
AI_SERVICE_URL=http://localhost:8001
APP_URL=https://apex.quantrolabs.app
# Public privacy policy URL for App Store / Play (host docs/legal/privacy.html here)
PRIVACY_POLICY_URL=https://apex.quantrolabs.app/privacy
API_BASE_URL=http://10.0.2.2:3000
MARKET_OBSERVER_INTERVAL_MS=60000
GEMINI_API_KEY=
